# ════════════════════════════════════════════════
# UPLOADS — Block PHP execution untuk keamanan
# (mencegah upload script PHP berbahaya dieksekusi)
# ════════════════════════════════════════════════

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phar|cgi|pl|py|jsp|asp|sh|exe)$">
    Order Allow,Deny
    Deny from all
</FilesMatch>

# Tetap izinkan akses gambar/PDF
<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|pdf|ico)$">
    Order Allow,Deny
    Allow from all
</FilesMatch>

Options -ExecCGI -Indexes
